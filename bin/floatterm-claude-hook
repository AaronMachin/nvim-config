#!/bin/bash
# Claude Code hook for floating-terminal tabs (see lua/floatterm/claude.lua).
#
# Claude runs this for SessionStart, UserPromptSubmit, Notification, Stop and
# SessionEnd with the event's JSON on stdin. Inside a floatterm tab ($FLOATTERM_TAB_ID
# and $NVIM set) it hands the JSON to that nvim, which updates the tab's record.
# Anywhere else it does nothing.
#
# It must never hold Claude up or change what Claude does: it always exits 0, prints
# nothing (stdout from some events becomes context for Claude), and gives up on an
# nvim that hasn't answered within a second.

if [ -z "$NVIM" ]; then
  exit 0
fi
case "$FLOATTERM_TAB_ID" in
  '' | *[!0-9]*) exit 0 ;;
esac

# Nothing goes to Claude, including bash's own note when the watchdog is stopped.
exec >/dev/null 2>&1

# A file rather than an argument, so the prompt needs no quoting. nvim deletes it
# after reading; the rm below covers an nvim that never got to it.
payload=$(mktemp "${TMPDIR:-/tmp}/floatterm-hook.XXXXXX") || exit 0
cat >"$payload"

expr="luaeval('(function(a) local ok, m = pcall(require, \"floatterm.claude\") if ok then pcall(m.hook, a[1], a[2]) end return 0 end)(_A)', ['$FLOATTERM_TAB_ID', '$payload'])"
nvim --clean --headless --server "$NVIM" --remote-expr "$expr" &
pid=$!
(sleep 1 && kill "$pid") &
watchdog=$!
wait "$pid"
kill "$watchdog"

rm -f "$payload"
exit 0
