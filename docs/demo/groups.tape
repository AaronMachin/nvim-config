# Claude tabs under a parent: g numbers the tabs to pick one, za folds.
Output docs/gifs/groups.gif
Set Shell zsh
Set FontFamily "UbuntuMono Nerd Font Mono"
Set FontSize 17
Set Width 1280
Set Height 760
Set Padding 16
Set TypingSpeed 70ms
Set Theme "OneDark"

Hide
Type "docs/demo/run-nvim.sh seed-groups.lua server.js" Enter
Sleep 5s
Show

Sleep 1.5s
Ctrl+G
Sleep 1.5s
Ctrl+B
Sleep 2s
Type "jj"
Sleep 2s
Type "g"
Sleep 2.5s
Type "1"
Sleep 0.8s
Enter
Sleep 2.5s
Type "k"
Sleep 1.5s
Type "k"
Sleep 2s
Type "za"
Sleep 2.5s
Type "za"
Sleep 2s
Escape
Sleep 2s
